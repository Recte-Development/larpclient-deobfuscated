{
    "schemaVersion": 1,
    "id": "larp-client",
    "version": "2.3.1",
    "name": "LarpClient",
    "icon": "assets/larp-client/icon.png",
    "description": "A utility mod for Minecraft by Tobias.",
    "authors": [
        "Tobias"
    ],
    "contact": {
        
    },
    "license": "LicenseRef-LarpClient-EULA",
    "environment": "client",
    "entrypoints": {
        "client": [
            "com.larpclient.LarpClient"
        ]
    },
    "mixins": [
        "larpclient.mixins.json",
        "fake-spawner.mixins.json"
    ],
    "accessWidener": "larpclient.accesswidener",
    "depends": {
        "fabricloader": ">=0.19.5",
        "minecraft": "~1.21.11",
        "java": ">=21",
        "fabric-api": "*"
    },
    "jars": [
        {
            "file": "META-INF/jars/MinecraftAuth-5.0.2.jar"
        },
        {
            "file": "META-INF/jars/gson-1.9.2.jar"
        },
        {
            "file": "META-INF/jars/httpclient-1.9.2.jar"
        }
    ]
}
